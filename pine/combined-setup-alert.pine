// Combined Buy/Sell Setup Alert
// Merges the arrow signals from "TMA Overlay" (3 Line Strike + Engulfing Candle)
// with the RSI confirmation from "TMA - RSI Divergence Indicator"
// (RSI line vs its own 50-period smoothed average) into a single alert-firing
// script. Add this to your chart alongside your existing indicators, then
// create a TradingView alert on "Buy Setup" / "Sell Setup" with a webhook URL.
//@version=4
study(title="Combined Buy/Sell Setup Alert", shorttitle="Setup Alert", overlay=true)

// --- RSI + smoothed RSI (from TMA - RSI Divergence Indicator) ---
rsiLen = 14
osc = rsi(close, rsiLen)

smmaLen = 50
smma = 0.0
smma := na(smma[1]) ? sma(osc, smmaLen) : (smma[1] * (smmaLen - 1) + osc) / smmaLen

rsiBullish = osc > smma  // yellow line above white line
rsiBearish = osc < smma  // yellow line below white line

// --- Arrow patterns (from TMA Overlay) ---
// 3 Line Strike: three same-direction candles reversed by a fourth
strike3Bull = close[3] < open[3] and close[2] < open[2] and close[1] < open[1] and close > open[1]
strike3Bear = close[3] > open[3] and close[2] > open[2] and close[1] > open[1] and close < open[1]

// Engulfing candle
openPrev = open[1]
closePrev = close[1]
engulfBull = open <= closePrev and open < openPrev and close > openPrev
engulfBear = open >= closePrev and open > openPrev and close < openPrev

arrowBull = strike3Bull or engulfBull
arrowBear = strike3Bear or engulfBear

// --- Combined setup ---
buySetup = arrowBull and rsiBullish
sellSetup = arrowBear and rsiBearish

plotshape(buySetup, title="Buy Setup", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, text="BUY", size=size.small)
plotshape(sellSetup, title="Sell Setup", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, text="SELL", size=size.small)

// Replace REPLACE_WITH_YOUR_SECRET with the same value you set as WEBHOOK_SECRET
// on the relay (see telegram-relay/). This stops randoms from spamming your bot
// if they ever guess your webhook URL.
alertcondition(buySetup, title="Buy Setup", message="{\"side\":\"BUY\",\"symbol\":\"{{ticker}}\",\"interval\":\"{{interval}}\",\"price\":\"{{close}}\",\"time\":\"{{time}}\",\"secret\":\"REPLACE_WITH_YOUR_SECRET\"}")
alertcondition(sellSetup, title="Sell Setup", message="{\"side\":\"SELL\",\"symbol\":\"{{ticker}}\",\"interval\":\"{{interval}}\",\"price\":\"{{close}}\",\"time\":\"{{time}}\",\"secret\":\"REPLACE_WITH_YOUR_SECRET\"}")
