// TMA Trend Scalper - verification build.
//
// Entry logic is the vFinal reference's, condition for condition. What is different
// is everything around it, so the thing can actually be CHECKED on a chart:
//
//   1. POSITION SIZING BUG FIXED. The reference passed `qty=1` to strategy.entry(),
//      which overrides default_qty_type/default_qty_value - those apply only when qty
//      is omitted. It therefore traded 1 unit of base currency (~$0.65 on AUDUSD)
//      regardless of the documented "risk 1%" rule, so its Strategy Tester output was
//      a near-flat line that did not test the strategy. Size now comes from the stop
//      distance, which is what risking a fixed % means when the stop is 2x a candle
//      that changes size every bar.
//
//   2. LIVE CONFLUENCE TABLE, top-right. Every gate, every bar, with the number
//      behind it. When a signal you expected does not fire, one row is red.
//
//   3. ALERTS CARRY THE LEVELS, so the Telegram relay does not re-derive them.
//
// KNOWN DISCREPANCY IN THE SOURCE, surfaced rather than silently "corrected" - see
// STRIKE_REF below. The reference's 3-Line Strike code and the reference's own
// written description of it disagree, and the code is what has been forward-tested.

//@version=6
strategy(title="TMA Trend Scalper (verify)", shorttitle="TMA Scalp", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     initial_capital=1000, currency=currency.USD,
     commission_type=strategy.commission.percent, commission_value=0.03,
     calc_on_every_tick=false, process_orders_on_close=true)
// commission_value must be a const, so it cannot be driven from an input - edit the
// 0.03 above to match your broker. It applies PER ORDER, so a round trip costs twice
// it, and the result is very sensitive to the number.

// ============================================
// INPUTS
// ============================================

riskPct    = input.float(1.0,  "Risk % per trade",         minval=0.1, maxval=10, step=0.1, group="Risk")
stopMult   = input.float(2.0,  "Stop = N x candle size",   minval=0.5, step=0.5,  group="Risk")
targetMult = input.float(4.0,  "Target = N x candle size", minval=0.5, step=0.5,  group="Risk")

sessWindow = input.session("0700-1500", "Session (London local time)", group="Session",
     tooltip="London LOCAL, not UTC. The two agree only in winter: London runs UTC+1 under BST from late March to late October, so a UTC-pinned window slides an hour off the session every year.")

minDist  = input.float(0.001, "Min SMMA separation", step=0.0001, group="Filters",
     tooltip="Absolute price distance, so it does not scale across quote currencies: 0.001 for EURUSD/GBPUSD/AUDUSD, 0.10 for JPY pairs, 100 for BTC/ETH.")
adxMin   = input.float(25.0, "ADX minimum", minval=0, group="Filters")
atrMult  = input.float(0.7,  "ATR vs its 50-bar average", minval=0, step=0.05, group="Filters")

// THE DISCREPANCY. The reference's written spec says a bull 3-Line Strike is three
// red candles then a green one engulfing "the open of the 1st red candle" - that
// would be open[3]. The reference's actual CODE compares against open[1], the open of
// the LAST red candle, which is a materially weaker condition and fires far more
// often. Every port in this repo follows the code, because the code is what has been
// forward-tested. Default therefore stays as-is; flip this to test the textbook
// definition, but know it changes which trades you get.
strictStrike = input.bool(false, "3-Line Strike must engulf the FIRST of the three", group="Filters",
     tooltip="Off (default) = the reference's code: close beyond open[1], the last of the three. On = the reference's written spec and the textbook pattern: close beyond open[3], the first of the three. Stricter, fires less often.")

oneTradePerDay = input.bool(true, "One trade per day maximum", group="Filters",
     tooltip="The strategy's own golden rule. Off = allow re-entry after a trade closes the same day.")
showTable = input.bool(true, "Show confluence table", group="Display")

// ============================================
// SESSION (London local, weekdays only)
// ============================================
// ":23456" is Monday-Friday (Pine numbers days 1=Sunday..7=Saturday). Hours, weekday
// and timezone all resolved by one call rather than a hand-rolled `hour >=` against
// whatever zone the chart happens to be set to - which is what keeps this in step
// with the Telegram worker's Europe/London gate instead of drifting from it.
inSession = not na(time(timeframe.period, sessWindow + ":23456", "Europe/London"))
bgcolor(inSession ? color.new(color.blue, 92) : na, title="Session")

// ============================================
// SMMA 21 / 50 / 200
// ============================================

smma(src, len) =>
    s = 0.0
    s := na(s[1]) ? ta.sma(src, len) : (s[1] * (len - 1) + src) / len
    s

smma21  = smma(close, 21)
smma50  = smma(close, 50)
smma200 = smma(close, 200)
ema2    = ta.ema(close, 2)

// ============================================
// FILTERS
// ============================================

adxVal     = ta.adx(high, low, close, 14)
isTrending = adxVal > adxMin

atrVal        = ta.atr(14)
atrAvg        = ta.sma(atrVal, 50)
hasVolatility = atrVal > atrAvg * atrMult

// Both gaps must clear minDist, so the binding one is the smaller - that is what the
// table reports, rather than only the 21/50 gap, which can look healthy while the
// 50/200 gap is the one actually blocking the setup.
gapFast   = smma21 - smma50
gapSlow   = smma50 - smma200
bullStack = gapFast > minDist and gapSlow > minDist
bearStack = gapFast < -minDist and gapSlow < -minDist
bindingGap = math.min(math.abs(gapFast), math.abs(gapSlow))

priceAbove200 = close > smma200
priceBelow200 = close < smma200

sma5         = ta.sma(close, 5)
bullMomentum = close > sma5 and close > close[5]
bearMomentum = close < sma5 and close < close[5]

bullTrendQuality = bullStack and isTrending and priceAbove200 and bullMomentum and hasVolatility
bearTrendQuality = bearStack and isTrending and priceBelow200 and bearMomentum and hasVolatility

// ============================================
// PATTERNS
// ============================================

threeDown = close[3] < open[3] and close[2] < open[2] and close[1] < open[1]
threeUp   = close[3] > open[3] and close[2] > open[2] and close[1] > open[1]
strikeRef = strictStrike ? open[3] : open[1]

bullSig = threeDown and close > strikeRef
bearSig = threeUp   and close < strikeRef

bullishEngulfing = open <= close[1] and open < open[1] and close > open[1]
bearishEngulfing = open >= close[1] and open > open[1] and close < open[1]

bullPattern = bullSig or bullishEngulfing
bearPattern = bearSig or bearishEngulfing
patternName = bullSig or bearSig ? "3-Line Strike" : bullishEngulfing or bearishEngulfing ? "Engulfing" : ""

// ============================================
// RSI
// ============================================

osc     = ta.rsi(close, 14)
smmaOsc = smma(osc, 50)
rsiBullish = osc > 50 and osc > smmaOsc
rsiBearish = osc < 50 and osc < smmaOsc

// ============================================
// ONE TRADE PER DAY
// ============================================

var int tradesToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0
dayLimitOK = not oneTradePerDay or tradesToday < 1

// ============================================
// SIGNALS
// ============================================

buySignal  = inSession and bullTrendQuality and bullPattern and rsiBullish and dayLimitOK
sellSignal = inSession and bearTrendQuality and bearPattern and rsiBearish and dayLimitOK

// ============================================
// LEVELS + SIZE
// ============================================
// Computed once, at top level, and reused by the orders, the plots and the alert
// text. The reference recomputed the stop and target inside its alert string, which
// is how the two quietly drift apart.
//
// qty = risk / stopDist yields units of the BASE currency. That is exact when the
// quote currency is the account currency (AUD/USD, EUR/USD, GBP/USD on a USD
// account). On a JPY-quoted pair the stop distance is in JPY while the risk is in
// USD, so the size is off by the USD/JPY rate - fine for the recommended AUD/USD,
// worth knowing before reading a USD/JPY equity curve.

candleSize = high - low
stopDist   = candleSize * stopMult
targetDist = candleSize * targetMult
longStop   = close - stopDist
longTarget = close + targetDist
shortStop  = close + stopDist
shortTarget= close - targetDist
qtyRaw     = stopDist > 0 ? (strategy.equity * riskPct / 100) / stopDist : 0

if buySignal and strategy.position_size == 0 and qtyRaw > 0
    tradesToday += 1
    strategy.entry("Long", strategy.long, qty=qtyRaw)
    strategy.exit("Exit Long", "Long", stop=longStop, limit=longTarget)

if sellSignal and strategy.position_size == 0 and qtyRaw > 0
    tradesToday += 1
    strategy.entry("Short", strategy.short, qty=qtyRaw)
    strategy.exit("Exit Short", "Short", stop=shortStop, limit=shortTarget)

// ============================================
// CONFLUENCE TABLE
// ============================================
// DIRECTION COMES FROM THE STACK, not from the full trend-quality flag. Using the
// full flag meant that as soon as any one gate failed, BOTH quality flags went false
// and every direction-dependent row below flipped to asking the OPPOSITE question -
// so a bullish setup blocked only by a weak ADX would also show "Price vs 200" red
// while price sat correctly above the 200. The stack is what determines which side
// is even tradeable, so it is what the rest of the rows are asked about. This also
// keeps the table in step with the ?debug=1 output from the Telegram worker, which
// is the whole point of having it.

mark(bool ok) => ok ? "✔" : "✘"
markCol(bool ok) => ok ? color.new(color.lime, 0) : color.new(color.red, 0)

if showTable and barstate.islast
    var table t = table.new(position.top_right, 3, 9, border_width=1)
    dirLabel = bullStack ? "BULL" : bearStack ? "BEAR" : "none"

    table.cell(t, 0, 0, "CONFLUENCE", text_color=color.white, bgcolor=color.new(color.blue, 40), text_size=size.small)
    table.cell(t, 1, 0, dirLabel,     text_color=color.white, bgcolor=color.new(color.blue, 40), text_size=size.small)
    table.cell(t, 2, 0, "value",      text_color=color.white, bgcolor=color.new(color.blue, 40), text_size=size.small)

    posOK = bullStack ? priceAbove200 : bearStack ? priceBelow200 : false
    momOK = bullStack ? bullMomentum  : bearStack ? bearMomentum  : false
    patOK = bullStack ? bullPattern   : bearStack ? bearPattern   : false
    rsiOK = bullStack ? rsiBullish    : bearStack ? rsiBearish    : false
    atrPct = na(atrAvg) or atrAvg == 0 ? na : atrVal / atrAvg * 100

    rows = array.from("Session " + sessWindow + " LDN", "SMMA stack + gap", "ADX > " + str.tostring(adxMin, "#.#"), "ATR volatility", "Price vs 200", "Momentum", "Pattern", "RSI vs SMMA")
    oks  = array.from(inSession, bullStack or bearStack, isTrending, hasVolatility, posOK, momOK, patOK, rsiOK)
    vals = array.from(
       str.format_time(time, "HH:mm", "Europe/London"),
       str.tostring(bindingGap, format.mintick),
       str.tostring(adxVal, "#.#"),
       na(atrPct) ? "-" : str.tostring(atrPct, "#") + "%",
       str.tostring(close - smma200, format.mintick),
       str.tostring(close - sma5, format.mintick),
       patternName == "" ? "-" : patternName,
       str.tostring(osc, "#.#") + " / " + str.tostring(smmaOsc, "#.#"))

    for i = 0 to array.size(rows) - 1
        ok = array.get(oks, i)
        table.cell(t, 0, i + 1, array.get(rows, i), text_color=color.silver, text_size=size.small)
        table.cell(t, 1, i + 1, mark(ok), text_color=markCol(ok), text_size=size.small)
        table.cell(t, 2, i + 1, array.get(vals, i), text_color=color.silver, text_size=size.small)

// ============================================
// PLOTTING
// ============================================

plot(smma21,  color=color.white, linewidth=2, title="21 SMMA")
plot(smma50,  color=color.lime,  linewidth=2, title="50 SMMA")
plot(smma200, color=color.red,   linewidth=2, title="200 SMMA")
plot(ema2,    color=color.new(color.blue, 40), linewidth=1, title="EMA 2")

plotshape(buySignal,  title="Buy Signal",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, text="BUY")
plotshape(sellSignal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, text="SELL")

bgcolor(bullTrendQuality ? color.new(color.green, 92) : bearTrendQuality ? color.new(color.red, 92) : na, title="Trend quality")

// ============================================
// ALERTS
// ============================================

alertMsg(string side) =>
    st = side == "BUY" ? longStop : shortStop
    tp = side == "BUY" ? longTarget : shortTarget
    str.format("{0}|{1}|entry={2}|sl={3}|tp={4}|candle={5}|rsi={6}|adx={7}|pattern={8}",
       side, syminfo.ticker, str.tostring(close, format.mintick), str.tostring(st, format.mintick),
       str.tostring(tp, format.mintick), str.tostring(candleSize, format.mintick),
       str.tostring(osc, "#.#"), str.tostring(adxVal, "#.#"), patternName)

alertcondition(buySignal,  title="BUY Signal",  message="TMA BUY")
alertcondition(sellSignal, title="SELL Signal", message="TMA SELL")

if buySignal
    alert(alertMsg("BUY"), alert.freq_once_per_bar_close)
if sellSignal
    alert(alertMsg("SELL"), alert.freq_once_per_bar_close)
